# ---- Backend (config from the API project) ----
# Base URL of the running backend (no trailing slash, no /api suffix)
VITE_API_BASE_URL=http://localhost:5000

# Tenant / school slug -> sent as the X-School-Slug header on every request
VITE_DEFAULT_SCHOOL_SLUG=adarsh-rkm

# Production: "true" = derive the slug from the hostname (greenwood.yourapp.com -> greenwood)
VITE_TENANT_FROM_HOST=false

# Optional (dev only): proxy /api/* through Vite to avoid CORS. If set, leave VITE_API_BASE_URL empty.
# VITE_DEV_PROXY_TARGET=http://localhost:5000

# ISO currency code used when formatting money
VITE_CURRENCY=INR

# ---- Link to the other app ----
# URL of the staff panel (the "Staff Login" links on the home page go there)
VITE_STAFF_PANEL_URL=http://localhost:5173
